script OldaleTown_EventScript_BerryMerchant {
    lock
    faceplayer
    msgbox(OldaleTown_Text_BerryMerchantGreeting)
    if (flag(FLAG_BADGE06_GET)) {
        pokemart(OldaleTown_Pokemart_Berry_Badge6)
    } elif (flag(FLAG_BADGE04_GET)) {
        pokemart(OldaleTown_Pokemart_Berry_Badge4)
    } else {
        pokemart(OldaleTown_Pokemart_Berry_Badge2)
    }
    msgbox(OldaleTown_Text_RareMerchantComeAgain)
    release
}

