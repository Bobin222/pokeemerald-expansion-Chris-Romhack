script OldaleTown_EventScript_EvolutionMerchant {
    lock
    faceplayer
    msgbox(OldaleTown_Text_EvolutionMerchantGreeting)
    if (flag(FLAG_BADGE08_GET)) {
        pokemart(OldaleTown_Pokemart_Evolution_Badge8)
    } elif (flag(FLAG_BADGE06_GET)) {
        pokemart(OldaleTown_Pokemart_Evolution_Badge6)
    } elif (flag(FLAG_BADGE04_GET)) {
        pokemart(OldaleTown_Pokemart_Evolution_Badge4)
    } else {
        pokemart(OldaleTown_Pokemart_Evolution_Badge2)
    }
    msgbox(OldaleTown_Text_RareMerchantComeAgain)
    release
}

text OldaleTown_Text_EvolutionMerchantGreeting {
    format("Welcome! I handle everything evolution-related here; stones, held items, all of it. Take a look!")
}

