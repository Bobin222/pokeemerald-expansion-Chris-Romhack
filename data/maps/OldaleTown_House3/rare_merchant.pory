script OldaleTown_EventScript_RareMerchant {
    lock
    faceplayer
    if (flag(FLAG_BADGE08_GET)) {
        msgbox(OldaleTown_Text_RareMerchantLucrative)
    } elif (flag(FLAG_BADGE06_GET)) {
        msgbox(OldaleTown_Text_RareMerchantPopular)
    } elif (flag(FLAG_BADGE02_GET)) {
        msgbox(OldaleTown_Text_RareMerchantGrowing)
    } else {
        msgbox(OldaleTown_Text_RareMerchantGreeting)
    }
    if (flag(FLAG_BADGE08_GET)) {
        pokemart(OldaleTown_Pokemart_Misc_Badge8)
    } elif (flag(FLAG_BADGE06_GET)) {
        pokemart(OldaleTown_Pokemart_Misc_Badge6)
    } elif (flag(FLAG_BADGE04_GET)) {
        pokemart(OldaleTown_Pokemart_Misc_Badge4)
    } elif (flag(FLAG_BADGE02_GET)) {
        pokemart(OldaleTown_Pokemart_Misc_Badge2)
    } else {
        pokemart(OldaleTown_Pokemart_RareMerchant_Starter)
    }
    msgbox(OldaleTown_Text_RareMerchantComeAgain)
    release
}

text OldaleTown_Text_RareMerchantGreeting {
    format("Welcome to my little shop! We're a small but mighty operation right now, but we're planning on expanding into rare items!")
}

text OldaleTown_Text_RareMerchantGrowing {
    format("Welcome back! Business has been so good, I had to bring in some help! Check out the other stalls, they specialize in stuff I just don't have room for anymore!")
}

text OldaleTown_Text_RareMerchantPopular {
    format("You've probably noticed we've gotten pretty popular with trainers lately! I can barely keep up with demand!")
}

text OldaleTown_Text_RareMerchantLucrative {
    format("Business is absolutely booming these days! Who knew rare items could be this lucrative? Thanks for shopping with us from the start!")
}

text OldaleTown_Text_RareMerchantComeAgain {
    format("Thanks for stopping by!")
}

mart OldaleTown_Pokemart_RareMerchant_Starter {
    ITEM_ABILITY_CAPSULE
    ITEM_NET_BALL
    ITEM_TIMER_BALL
    ITEM_LUXURY_BALL
    ITEM_ORAN_BERRY
}

